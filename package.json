{
  "name": "ncet-store-pos",
  "version": "2.0.0",
  "private": true,
  "description": "NCET General Store POS v2 - browser-based multi-counter point of sale",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose -f ops/docker-compose.yml up -d db",
    "db:down": "docker compose -f ops/docker-compose.yml down",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api",
    "migrate": "npm run migrate:deploy -w apps/api",
    "seed": "npm run seed -w apps/api",
    "seed:demo": "npm run seed:demo -w apps/api",
    "smoke": "node scripts/smoke-test.mjs",
    "rush": "node scripts/rush-test.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  }
}
