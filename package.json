{
  "name": "ncet-store-pos",
  "version": "2.0.0",
  "private": true,
  "description": "NCET General Store POS v2 - browser-based multi-counter point of sale",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:up": "docker compose -f ops/docker-compose.yml up -d db",
    "db:down": "docker compose -f ops/docker-compose.yml down",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "migrate": "npm run migrate:deploy -w backend",
    "seed": "npm run seed -w backend",
    "seed:demo": "npm run seed:demo -w backend",
    "smoke": "node scripts/smoke-test.mjs",
    "rush": "node scripts/rush-test.mjs",
    "migrate:from-postgres": "npm run migrate:from-postgres -w backend --",
    "check:stock": "npm run check:stock -w backend",
    "backup": "npm run backup -w backend",
    "backup:test": "npm run backup:test -w backend --",
    "backup:restore": "npm run backup:restore -w backend --",
    "soak": "node scripts/soak-test.mjs",
    "perf:stock": "npm run perf:stock -w backend"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  }
}
