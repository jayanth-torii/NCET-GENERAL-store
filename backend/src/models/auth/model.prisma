// Users and login sessions.

enum Role {
  ADMIN
  MANAGER
  STORE_KEEPER
  CASHIER
}

model AppUser {
  id                 Int       @id @default(0) @map("_id")
  username           String    @unique
  fullName           String    @map("full_name")
  role               Role
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  lockedAt           DateTime? @map("locked_at") // counter locked with Ctrl+L; every request refused until unlocked
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sales             Sale[]
  cancelledSales    Sale[]            @relation("SaleCancelledBy")
  heldBills         HeldBill[]
  purchasesCreated  Purchase[]        @relation("PurchaseCreatedBy")
  purchasesPosted   Purchase[]        @relation("PurchasePostedBy")
  purchasesReadied  Purchase[]        @relation("PurchaseReadyBy")
  movements         StockMovement[]
  auditLogs         AuditLog[]
  adjustmentsAsked  StockAdjustment[] @relation("AdjRequestedBy")
  adjustmentsDecide StockAdjustment[] @relation("AdjDecidedBy")
  salesReturns      SalesReturn[]
  purchaseReturns   PurchaseReturn[]
  sessions          Session[]

  @@map("app_user")
}

// One row per login. The cookie carries the session id; logging out, a password change, or an admin
// revoke marks it revoked and every later request with that cookie is refused.
model Session {
  id         String    @id @default(uuid()) @map("_id")
  userId     Int       @map("user_id")
  counterId  Int?      @map("counter_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by") // LOGOUT, PASSWORD_CHANGE, ADMIN, USER_DISABLED, EXPIRED

  user AppUser @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("session")
}
