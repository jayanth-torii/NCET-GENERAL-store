// Product master and the cached stock balance per product.

model Product {
  id           Int      @id @default(0) @map("_id")
  code         String   @unique // legacy Item Code kept
  barcode      String?          // unique when set: partial index product_barcode_key (src/config/mongo-indexes.ts)
  name         String
  nameKey      String?  @map("name_key") // lower-case, single-spaced name; unique among active products (product_name_uq)
  categoryId   Int      @map("category_id")
  unitId       Int      @map("unit_id")
  packUnitId   Int?     @map("pack_unit_id")
  packSize     Float    @default(1) @map("pack_size")
  hsnCode      String?  @map("hsn_code")
  gstRate      Float    @default(0) @map("gst_rate")
  mrp          Float?
  salePrice    Float    @map("sale_price")
  lastCost     Float?   @map("last_cost")
  reorderLevel Float    @default(0) @map("reorder_level")
  rackNo       String?  @map("rack_no")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category      Category           @relation(fields: [categoryId], references: [id])
  unit          Unit               @relation("ProductUnit", fields: [unitId], references: [id])
  packUnit      Unit?              @relation("ProductPackUnit", fields: [packUnitId], references: [id])
  stock         ProductStock?
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  kitItems      KitItem[]
  kitComponents SaleKitComponent[]
  adjustments   StockAdjustment[]

  @@index([categoryId])
  @@map("product")
}

model ProductStock {
  productId Int     @id @map("_id")
  onHand    Float   @default(0) @map("on_hand")
  product   Product @relation(fields: [productId], references: [id])

  @@map("product_stock")
}
