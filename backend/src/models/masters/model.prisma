// Masters: counters, categories, units, suppliers, purchase charge types.

enum ChargeAllocation {
  BY_VALUE
  BY_QTY
  NONE
}

model Counter {
  id          Int      @id @default(0) @map("_id")
  code        String   @unique // C1, C2 ... used as bill prefix
  name        String
  printerName String?  @map("printer_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  sales     Sale[]
  heldBills HeldBill[]

  @@map("counter")
}

model Category {
  id       Int       @id @default(0) @map("_id")
  name     String    @unique
  products Product[]

  @@map("category")
}

model Unit {
  id           Int       @id @default(0) @map("_id")
  code         String    @unique // PCS, BOX, PKT, REAM, DOZ
  name         String
  allowDecimal Boolean   @default(false) @map("allow_decimal")
  products     Product[] @relation("ProductUnit")
  packProducts Product[] @relation("ProductPackUnit")

  @@map("unit")
}

model Supplier {
  id        Int              @id @default(0) @map("_id")
  name      String           @unique
  phone     String?
  gstin     String?
  address   String?
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  purchases Purchase[]
  returns   PurchaseReturn[]

  @@map("supplier")
}

model ChargeType {
  id         Int              @id @default(0) @map("_id")
  name       String           @unique
  addsToCost Boolean          @default(true) @map("adds_to_cost")
  allocation ChargeAllocation @default(BY_VALUE)
  isActive   Boolean          @default(true) @map("is_active")
  charges    PurchaseCharge[]

  @@map("charge_type")
}
