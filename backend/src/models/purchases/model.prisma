// Purchases (GRN): header, lines, charges, and returns to suppliers.

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EntryUnit {
  PACK
  BASE
}

model Purchase {
  id                Int            @id @default(0) @map("_id")
  purchaseNo        String?        @map("purchase_no") // unique when set: partial index purchase_purchase_no_key; // GRN number, GRN/26-27/0001, assigned when the bill is first saved
  supplierId        Int            @map("supplier_id")
  supplierInvoiceNo String         @map("supplier_invoice_no")
  invoiceKey        String?        @map("invoice_key") // lower(trim(invoice no)); unique per supplier while not cancelled (purchase_supplier_invoice_uq)
  invoiceDate       DateTime       @map("invoice_date")
  taxInclusive      Boolean        @default(false) @map("tax_inclusive")
  itemsTotal        Float          @default(0) @map("items_total")
  taxTotal          Float          @default(0) @map("tax_total")
  chargesTotal      Float          @default(0) @map("charges_total")
  discountTotal     Float          @default(0) @map("discount_total")
  roundOff          Float          @default(0) @map("round_off")
  grandTotal        Float          @default(0) @map("grand_total")
  invoiceTotal      Float?         @map("invoice_total")
  status            PurchaseStatus @default(DRAFT)
  notes             String?
  readyAt           DateTime?      @map("ready_at") // store keeper marked it ready for a manager to post
  readyById         Int?           @map("ready_by")
  readyBy           AppUser?       @relation("PurchaseReadyBy", fields: [readyById], references: [id])
  createdById       Int            @map("created_by")
  postedById        Int?           @map("posted_by")
  postedAt          DateTime?      @map("posted_at")
  cancelledAt       DateTime?      @map("cancelled_at")
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  createdBy AppUser          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  postedBy  AppUser?         @relation("PurchasePostedBy", fields: [postedById], references: [id])
  items     PurchaseItem[]
  charges   PurchaseCharge[]
  returns   PurchaseReturn[]

  @@index([supplierId])
  @@index([status, postedAt])
  @@map("purchase")
}

model PurchaseItem {
  id             Int       @id @default(0) @map("_id")
  purchaseId     Int       @map("purchase_id")
  productId      Int       @map("product_id")
  lineNo         Int       @map("line_no")
  entryUnit      EntryUnit @default(BASE) @map("entry_unit")
  enteredQty     Float     @map("entered_qty")
  packSize       Float     @map("pack_size")
  baseQty        Float     @map("base_qty")
  rate           Float // per entered unit
  grossAmount    Float     @map("gross_amount") // qty x rate, or the typed line amount
  discount       Float     @default(0)
  gstRate        Float     @default(0) @map("gst_rate")
  taxAmount      Float     @default(0) @map("tax_amount")
  lineTotal      Float     @map("line_total")
  landedUnitCost Float?    @map("landed_unit_cost")
  batch          String?
  expiry         DateTime?
  // New selling price (and MRP) typed on the GRN. Applied to the product master when the GRN is posted.
  salePrice      Float?    @map("sale_price")
  mrp            Float?

  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id])
  returnLines PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_item")
}

model PurchaseCharge {
  id           Int     @id @default(0) @map("_id")
  purchaseId   Int     @map("purchase_id")
  chargeTypeId Int     @map("charge_type_id")
  amount       Float
  paidTo       String? @map("paid_to") // transporter
  referenceNo  String? @map("reference_no") // LR number

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  @@index([purchaseId])
  @@map("purchase_charge")
}

model PurchaseReturn {
  id         Int      @id @default(0) @map("_id")
  returnNo   String   @unique @map("return_no")
  purchaseId Int      @map("purchase_id")
  supplierId Int      @map("supplier_id")
  userId     Int      @map("user_id")
  reason     String
  total      Float
  createdAt  DateTime @default(now()) @map("created_at")

  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  user     AppUser              @relation(fields: [userId], references: [id])
  items    PurchaseReturnItem[]

  @@index([createdAt])
  @@map("purchase_return")
}

model PurchaseReturnItem {
  id             Int   @id @default(0) @map("_id")
  returnId       Int   @map("return_id")
  purchaseItemId Int   @map("purchase_item_id")
  baseQty        Float @map("base_qty")
  amount         Float

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])

  @@index([purchaseItemId])
  @@map("purchase_return_item")
}
