// Counter sales: bills, lines, kit components, payments, held bills, returns.

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

model Sale {
  id             BigInt     @id @default(0) @map("_id")
  billNo         String     @unique @map("bill_no") // C2/26-27/000481
  counterId      Int        @map("counter_id")
  userId         Int        @map("user_id")
  billedAt       DateTime   @default(now()) @map("billed_at")
  itemsTotal     Float      @map("items_total")
  discountTotal  Float      @default(0) @map("discount_total")
  taxTotal       Float      @default(0) @map("tax_total")
  roundOff       Float      @default(0) @map("round_off")
  grandTotal     Float      @map("grand_total")
  tendered       Float      @default(0)
  changeDue      Float      @default(0) @map("change_due")
  status         SaleStatus @default(COMPLETED)
  idempotencyKey String     @unique @map("idempotency_key")
  customerName   String?    @map("customer_name")
  remarks        String?
  printCount     Int        @default(0) @map("print_count") // receipts issued; the 2nd onwards are stamped DUPLICATE
  priceOverride  Boolean    @default(false) @map("price_override") // a manager billed a line below the master price
  editedAt       DateTime?  @map("edited_at")
  editCount      Int        @default(0) @map("edit_count")
  cancelReason   String?    @map("cancel_reason")
  cancelledById  Int?       @map("cancelled_by")
  cancelledAt    DateTime?  @map("cancelled_at")
  rowVersion     Int        @default(0) @map("row_version") // bumped to claim the bill inside a transaction (edit / cancel / return)

  counter     Counter       @relation(fields: [counterId], references: [id])
  user        AppUser       @relation(fields: [userId], references: [id])
  cancelledBy AppUser?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  items       SaleItem[]
  payments    SalePayment[]
  returns     SalesReturn[]

  @@index([billedAt])
  @@index([counterId, billedAt])
  @@index([userId, billedAt])
  @@map("sale")
}

model SaleItem {
  id           Int     @id @default(0) @map("_id")
  saleId       BigInt  @map("sale_id")
  lineNo       Int     @map("line_no")
  productId    Int?    @map("product_id")
  kitId        Int?    @map("kit_id")
  codeSnapshot String  @map("code_snapshot")
  nameSnapshot String  @map("name_snapshot")
  qty          Float
  rate         Float
  masterRate   Float   @default(0) @map("master_rate") // price on the master at the time of sale
  discount     Float   @default(0)
  gstRate      Float   @default(0) @map("gst_rate")
  taxAmount    Float   @default(0) @map("tax_amount")
  lineTotal    Float   @map("line_total")
  costAtSale   Float   @default(0) @map("cost_at_sale") // per unit

  sale        Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id])
  kit         Kit?               @relation(fields: [kitId], references: [id])
  components  SaleKitComponent[]
  returnLines SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

// Snapshot of what one unit of a kit line contained when it was sold, so returns and reports stay correct
// even if the kit definition changes later.
model SaleKitComponent {
  id         Int     @id @default(0) @map("_id")
  saleItemId Int     @map("sale_item_id")
  productId  Int     @map("product_id")
  qtyPerKit  Float   @map("qty_per_kit")
  gstRate    Float   @default(0) @map("gst_rate")
  unitCost   Float   @default(0) @map("unit_cost")

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([saleItemId])
  @@map("sale_kit_component")
}

model SalePayment {
  id        Int         @id @default(0) @map("_id")
  saleId    BigInt      @map("sale_id")
  mode      PaymentMode
  amount    Float // amount applied to the bill (cash net of change)
  reference String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([mode, reference])
  @@map("sale_payment")
}

model HeldBill {
  id        Int      @id @default(0) @map("_id")
  counterId Int      @map("counter_id")
  userId    Int      @map("user_id")
  label     String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  counter Counter @relation(fields: [counterId], references: [id])
  user    AppUser @relation(fields: [userId], references: [id])

  @@index([counterId])
  @@map("held_bill")
}

model SalesReturn {
  id         Int         @id @default(0) @map("_id")
  returnNo   String      @unique @map("return_no")
  saleId     BigInt      @map("sale_id")
  userId     Int         @map("user_id")
  reason     String
  refundMode PaymentMode @default(CASH) @map("refund_mode")
  total      Float
  createdAt  DateTime    @default(now()) @map("created_at")

  sale  Sale              @relation(fields: [saleId], references: [id])
  user  AppUser           @relation(fields: [userId], references: [id])
  items SalesReturnItem[]

  @@index([createdAt])
  @@map("sales_return")
}

model SalesReturnItem {
  id         Int   @id @default(0) @map("_id")
  returnId   Int   @map("return_id")
  saleItemId Int   @map("sale_item_id")
  qty        Float
  amount     Float

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id])

  @@index([saleItemId])
  @@map("sales_return_item")
}
