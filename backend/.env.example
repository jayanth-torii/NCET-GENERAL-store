# Copy to .env and change every secret before going live.

# MongoDB (Atlas or self-hosted) — must be a replica set, because bills, GRNs and stock use transactions.
# Atlas: Database → Connect → Drivers. If Node cannot resolve the mongodb+srv:// form on the store PC
# ("querySrv ECONNREFUSED"), use the standard form with the three hosts listed, plus the database name:
#   mongodb://USER:PASSWORD@HOST-00:27017,HOST-01:27017,HOST-02:27017/ncet_store?tls=true&authSource=admin&replicaSet=REPLICA-SET&retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ncet_store?retryWrites=true&w=majority&appName=ncet-store-pos"

# Only for the one-time copy from the PostgreSQL edition (npm run migrate:from-postgres). Leave empty otherwise.
POSTGRES_URL=

# Long random string (at least 32 characters). Signing key for login sessions.
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# HTTP port the store server listens on.
PORT=3000

# Password given to the first admin account by `npm run seed`. The admin must change it at first login.
ADMIN_INITIAL_PASSWORD="ChangeMe@123"

# Optional HTTPS on the LAN. Point these at a local certificate and key to enable HTTPS.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Set to "production" on the store server.
NODE_ENV=development

# Log API requests slower than this many milliseconds (default 3000).
SLOW_REQUEST_MS=3000

# Backups (npm run backup; the API also runs one every night at 01:30 and a restore test on the 1st of each month).
# Folder for backup files (default: backend/backups). Keeps 30 daily + 12 monthly.
BACKUP_DIR=
# Extra copy, e.g. a USB disk (E:\ncet-backups).
BACKUP_USB_DIR=
# Cloud copy, e.g. a OneDrive / Google Drive synced folder. Only written when BACKUP_KEY is set (encrypted).
BACKUP_CLOUD_DIR=
# Passphrase that encrypts backups (AES-256-GCM). Keep it somewhere safe: without it a backup cannot be restored.
BACKUP_KEY=
# Set to 0 to switch off the nightly backup and monthly restore test.
BACKUP_ENABLED=1
