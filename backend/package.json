{
  "name": "@storepos/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate --schema src/models && nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "migrate:deploy": "prisma db push --schema src/models --skip-generate && tsx scripts/migrate-mongo.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check:stock": "tsx scripts/check-stock.ts",
    "migrate:from-postgres": "tsx scripts/migrate-from-postgres.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "multer": "^2.0.2",
    "pdfmake": "^0.2.20",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfmake": "^0.2.11",
    "@types/pg": "^8.11.10",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
