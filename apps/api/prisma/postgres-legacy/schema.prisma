// NCET Store POS v2 data model.
// Money: Decimal(12,2). Quantities: Decimal(12,3). Unit costs and rates: Decimal(12,4).
// All timestamps are timestamptz set by the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STORE_KEEPER
  CASHIER
}

enum MovementKind {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  CANCEL
}

enum ChargeAllocation {
  BY_VALUE
  BY_QTY
  NONE
}

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum EntryUnit {
  PACK
  BASE
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GstMode {
  NOT_REGISTERED
  REGISTERED
}

model AppUser {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  fullName           String   @map("full_name")
  role               Role
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  tokenVersion       Int      @default(0) @map("token_version")
  lockedAt           DateTime? @map("locked_at") @db.Timestamptz(6) // counter locked with Ctrl+L; every request refused until unlocked
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales             Sale[]
  cancelledSales    Sale[]            @relation("SaleCancelledBy")
  heldBills         HeldBill[]
  purchasesCreated  Purchase[]        @relation("PurchaseCreatedBy")
  purchasesPosted   Purchase[]        @relation("PurchasePostedBy")
  purchasesReadied  Purchase[]        @relation("PurchaseReadyBy")
  movements         StockMovement[]
  auditLogs         AuditLog[]
  adjustmentsAsked  StockAdjustment[] @relation("AdjRequestedBy")
  adjustmentsDecide StockAdjustment[] @relation("AdjDecidedBy")
  salesReturns      SalesReturn[]
  purchaseReturns   PurchaseReturn[]
  sessions          Session[]

  @@map("app_user")
}

// One row per login. The cookie carries the session id; logging out, a password change, or an admin
// revoke marks it revoked and every later request with that cookie is refused.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int       @map("user_id")
  counterId  Int?      @map("counter_id")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") // LOGOUT, PASSWORD_CHANGE, ADMIN, USER_DISABLED, EXPIRED

  user AppUser @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("session")
}

model Counter {
  id          Int      @id @default(autoincrement())
  code        String   @unique // C1, C2 ... used as bill prefix
  name        String
  printerName String?  @map("printer_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sales     Sale[]
  heldBills HeldBill[]

  @@map("counter")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("category")
}

model Unit {
  id           Int       @id @default(autoincrement())
  code         String    @unique // PCS, BOX, PKT, REAM, DOZ
  name         String
  allowDecimal Boolean   @default(false) @map("allow_decimal")
  products     Product[] @relation("ProductUnit")
  packProducts Product[] @relation("ProductPackUnit")

  @@map("unit")
}

model Product {
  id           Int      @id @default(autoincrement())
  code         String   @unique // legacy Item Code kept
  barcode      String?  @unique
  name         String
  categoryId   Int      @map("category_id")
  unitId       Int      @map("unit_id")
  packUnitId   Int?     @map("pack_unit_id")
  packSize     Decimal  @default(1) @map("pack_size") @db.Decimal(12, 3)
  hsnCode      String?  @map("hsn_code")
  gstRate      Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  salePrice    Decimal  @map("sale_price") @db.Decimal(12, 2)
  lastCost     Decimal? @map("last_cost") @db.Decimal(12, 4)
  reorderLevel Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 3)
  rackNo       String?  @map("rack_no")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      Category              @relation(fields: [categoryId], references: [id])
  unit          Unit                  @relation("ProductUnit", fields: [unitId], references: [id])
  packUnit      Unit?                 @relation("ProductPackUnit", fields: [packUnitId], references: [id])
  stock         ProductStock?
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  kitItems      KitItem[]
  kitComponents SaleKitComponent[]
  adjustments   StockAdjustment[]

  @@index([categoryId])
  @@map("product")
}

model ProductStock {
  productId Int     @id @map("product_id")
  onHand    Decimal @default(0) @map("on_hand") @db.Decimal(12, 3)
  product   Product @relation(fields: [productId], references: [id])

  @@map("product_stock")
}

model StockMovement {
  id          BigInt       @id @default(autoincrement())
  productId   Int          @map("product_id")
  kind        MovementKind
  qty         Decimal      @db.Decimal(12, 3) // signed: + in, - out
  unitCost    Decimal?     @map("unit_cost") @db.Decimal(12, 4)
  refType     String       @map("ref_type") // SALE, PURCHASE, SALES_RETURN, PURCHASE_RETURN, ADJUSTMENT, OPENING
  refId       BigInt       @map("ref_id")
  note        String?
  createdById Int?         @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product  @relation(fields: [productId], references: [id])
  createdBy AppUser? @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([refType, refId])
  @@map("stock_movement")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  phone     String?
  gstin     String?
  address   String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  purchases Purchase[]
  returns   PurchaseReturn[]

  @@map("supplier")
}

model ChargeType {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  addsToCost Boolean          @default(true) @map("adds_to_cost")
  allocation ChargeAllocation @default(BY_VALUE)
  isActive   Boolean          @default(true) @map("is_active")
  charges    PurchaseCharge[]

  @@map("charge_type")
}

model Purchase {
  id                Int            @id @default(autoincrement())
  purchaseNo        String?        @unique @map("purchase_no") // GRN number, GRN/26-27/0001, assigned when the bill is first saved
  supplierId        Int            @map("supplier_id")
  supplierInvoiceNo String         @map("supplier_invoice_no")
  invoiceDate       DateTime       @map("invoice_date") @db.Date
  taxInclusive      Boolean        @default(false) @map("tax_inclusive")
  itemsTotal        Decimal        @default(0) @map("items_total") @db.Decimal(12, 2)
  taxTotal          Decimal        @default(0) @map("tax_total") @db.Decimal(12, 2)
  chargesTotal      Decimal        @default(0) @map("charges_total") @db.Decimal(12, 2)
  discountTotal     Decimal        @default(0) @map("discount_total") @db.Decimal(12, 2)
  roundOff          Decimal        @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal        Decimal        @default(0) @map("grand_total") @db.Decimal(12, 2)
  invoiceTotal      Decimal?       @map("invoice_total") @db.Decimal(12, 2)
  status            PurchaseStatus @default(DRAFT)
  notes             String?
  readyAt           DateTime?      @map("ready_at") @db.Timestamptz(6) // store keeper marked it ready for a manager to post
  readyById         Int?           @map("ready_by")
  readyBy           AppUser?       @relation("PurchaseReadyBy", fields: [readyById], references: [id])
  createdById       Int            @map("created_by")
  postedById        Int?           @map("posted_by")
  postedAt          DateTime?      @map("posted_at") @db.Timestamptz(6)
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  createdBy AppUser          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  postedBy  AppUser?         @relation("PurchasePostedBy", fields: [postedById], references: [id])
  items     PurchaseItem[]
  charges   PurchaseCharge[]
  returns   PurchaseReturn[]

  // A partial unique index (supplier_id, lower(supplier_invoice_no)) WHERE status <> 'CANCELLED'
  // is created in the migration SQL to block double entry of one supplier bill.
  @@index([supplierId])
  @@index([status, postedAt])
  @@map("purchase")
}

model PurchaseItem {
  id             Int       @id @default(autoincrement())
  purchaseId     Int       @map("purchase_id")
  productId      Int       @map("product_id")
  lineNo         Int       @map("line_no")
  entryUnit      EntryUnit @default(BASE) @map("entry_unit")
  enteredQty     Decimal   @map("entered_qty") @db.Decimal(12, 3)
  packSize       Decimal   @map("pack_size") @db.Decimal(12, 3)
  baseQty        Decimal   @map("base_qty") @db.Decimal(12, 3)
  rate           Decimal   @db.Decimal(12, 4) // per entered unit
  grossAmount    Decimal   @map("gross_amount") @db.Decimal(12, 2) // qty x rate, or the typed line amount
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  gstRate        Decimal   @default(0) @map("gst_rate") @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal   @map("line_total") @db.Decimal(12, 2)
  landedUnitCost Decimal?  @map("landed_unit_cost") @db.Decimal(12, 4)
  batch          String?
  expiry         DateTime? @db.Date
  // New selling price (and MRP) typed on the GRN. Applied to the product master when the GRN is posted.
  salePrice      Decimal?  @map("sale_price") @db.Decimal(12, 2)
  mrp            Decimal?  @db.Decimal(12, 2)

  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id])
  returnLines PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_item")
}

model PurchaseCharge {
  id           Int     @id @default(autoincrement())
  purchaseId   Int     @map("purchase_id")
  chargeTypeId Int     @map("charge_type_id")
  amount       Decimal @db.Decimal(12, 2)
  paidTo       String? @map("paid_to") // transporter
  referenceNo  String? @map("reference_no") // LR number

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  @@index([purchaseId])
  @@map("purchase_charge")
}

model Kit {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  price     Decimal   @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     KitItem[]
  saleItems SaleItem[]

  @@map("kit")
}

model KitItem {
  id        Int     @id @default(autoincrement())
  kitId     Int     @map("kit_id")
  productId Int     @map("product_id")
  qty       Decimal @db.Decimal(12, 3)
  kit       Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([kitId, productId])
  @@map("kit_item")
}

model Sale {
  id             BigInt     @id @default(autoincrement())
  billNo         String     @unique @map("bill_no") // C2/26-27/000481
  counterId      Int        @map("counter_id")
  userId         Int        @map("user_id")
  billedAt       DateTime   @default(now()) @map("billed_at") @db.Timestamptz(6)
  itemsTotal     Decimal    @map("items_total") @db.Decimal(12, 2)
  discountTotal  Decimal    @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal    @default(0) @map("tax_total") @db.Decimal(12, 2)
  roundOff       Decimal    @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal     Decimal    @map("grand_total") @db.Decimal(12, 2)
  tendered       Decimal    @default(0) @db.Decimal(12, 2)
  changeDue      Decimal    @default(0) @map("change_due") @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  idempotencyKey String     @unique @map("idempotency_key") @db.Uuid
  customerName   String?    @map("customer_name")
  remarks        String?
  printCount     Int        @default(0) @map("print_count") // receipts issued; the 2nd onwards are stamped DUPLICATE
  priceOverride  Boolean    @default(false) @map("price_override") // a manager billed a line below the master price
  editedAt       DateTime?  @map("edited_at") @db.Timestamptz(6)
  editCount      Int        @default(0) @map("edit_count")
  cancelReason   String?    @map("cancel_reason")
  cancelledById  Int?       @map("cancelled_by")
  cancelledAt    DateTime?  @map("cancelled_at") @db.Timestamptz(6)

  counter     Counter       @relation(fields: [counterId], references: [id])
  user        AppUser       @relation(fields: [userId], references: [id])
  cancelledBy AppUser?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  items       SaleItem[]
  payments    SalePayment[]
  returns     SalesReturn[]

  @@index([billedAt])
  @@index([counterId, billedAt])
  @@index([userId, billedAt])
  @@map("sale")
}

model SaleItem {
  id           Int     @id @default(autoincrement())
  saleId       BigInt  @map("sale_id")
  lineNo       Int     @map("line_no")
  productId    Int?    @map("product_id")
  kitId        Int?    @map("kit_id")
  codeSnapshot String  @map("code_snapshot")
  nameSnapshot String  @map("name_snapshot")
  qty          Decimal @db.Decimal(12, 3)
  rate         Decimal @db.Decimal(12, 2)
  masterRate   Decimal @default(0) @map("master_rate") @db.Decimal(12, 2) // price on the master at the time of sale
  discount     Decimal @default(0) @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)
  costAtSale   Decimal @default(0) @map("cost_at_sale") @db.Decimal(12, 4) // per unit

  sale        Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id])
  kit         Kit?               @relation(fields: [kitId], references: [id])
  components  SaleKitComponent[]
  returnLines SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

// Snapshot of what one unit of a kit line contained when it was sold, so returns and reports stay correct
// even if the kit definition changes later.
model SaleKitComponent {
  id         Int     @id @default(autoincrement())
  saleItemId Int     @map("sale_item_id")
  productId  Int     @map("product_id")
  qtyPerKit  Decimal @map("qty_per_kit") @db.Decimal(12, 3)
  gstRate    Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  unitCost   Decimal @default(0) @map("unit_cost") @db.Decimal(12, 4)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([saleItemId])
  @@map("sale_kit_component")
}

model SalePayment {
  id        Int         @id @default(autoincrement())
  saleId    BigInt      @map("sale_id")
  mode      PaymentMode
  amount    Decimal     @db.Decimal(12, 2) // amount applied to the bill (cash net of change)
  reference String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payment")
}

model HeldBill {
  id        Int      @id @default(autoincrement())
  counterId Int      @map("counter_id")
  userId    Int      @map("user_id")
  label     String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  counter Counter @relation(fields: [counterId], references: [id])
  user    AppUser @relation(fields: [userId], references: [id])

  @@index([counterId])
  @@map("held_bill")
}

model SalesReturn {
  id         Int         @id @default(autoincrement())
  returnNo   String      @unique @map("return_no")
  saleId     BigInt      @map("sale_id")
  userId     Int         @map("user_id")
  reason     String
  refundMode PaymentMode @default(CASH) @map("refund_mode")
  total      Decimal     @db.Decimal(12, 2)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  sale  Sale              @relation(fields: [saleId], references: [id])
  user  AppUser           @relation(fields: [userId], references: [id])
  items SalesReturnItem[]

  @@index([createdAt])
  @@map("sales_return")
}

model SalesReturnItem {
  id         Int     @id @default(autoincrement())
  returnId   Int     @map("return_id")
  saleItemId Int     @map("sale_item_id")
  qty        Decimal @db.Decimal(12, 3)
  amount     Decimal @db.Decimal(12, 2)

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem    @relation(fields: [saleItemId], references: [id])

  @@index([saleItemId])
  @@map("sales_return_item")
}

model PurchaseReturn {
  id         Int      @id @default(autoincrement())
  returnNo   String   @unique @map("return_no")
  purchaseId Int      @map("purchase_id")
  supplierId Int      @map("supplier_id")
  userId     Int      @map("user_id")
  reason     String
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  user     AppUser              @relation(fields: [userId], references: [id])
  items    PurchaseReturnItem[]

  @@index([createdAt])
  @@map("purchase_return")
}

model PurchaseReturnItem {
  id             Int     @id @default(autoincrement())
  returnId       Int     @map("return_id")
  purchaseItemId Int     @map("purchase_item_id")
  baseQty        Decimal @map("base_qty") @db.Decimal(12, 3)
  amount         Decimal @db.Decimal(12, 2)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])

  @@index([purchaseItemId])
  @@map("purchase_return_item")
}

model StockAdjustment {
  id            Int              @id @default(autoincrement())
  productId     Int              @map("product_id")
  qtyChange     Decimal          @map("qty_change") @db.Decimal(12, 3)
  reason        String
  status        AdjustmentStatus @default(PENDING)
  requestedById Int              @map("requested_by")
  decidedById   Int?             @map("decided_by")
  decisionNote  String?          @map("decision_note")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)

  product     Product  @relation(fields: [productId], references: [id])
  requestedBy AppUser  @relation("AdjRequestedBy", fields: [requestedById], references: [id])
  decidedBy   AppUser? @relation("AdjDecidedBy", fields: [decidedById], references: [id])

  @@index([status])
  @@map("stock_adjustment")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// Gapless document numbers. One row per series, e.g. "SALE:C2:26-27".
// Incremented with INSERT .. ON CONFLICT DO UPDATE .. RETURNING inside the document's transaction,
// so each counter only ever waits on its own row.
model DocCounter {
  key   String @id
  value Int

  @@map("doc_counter")
}

model StoreSetting {
  id                 Int      @id @default(1)
  storeName          String   @default("GENERAL STORE") @map("store_name")
  addressLine        String   @default("Nagarjuna College of Engineering & Technology") @map("address_line")
  phone              String?
  gstin              String?
  gstMode            GstMode  @default(NOT_REGISTERED) @map("gst_mode")
  receiptFooter      String   @default("Thank you! Goods once sold can be returned only with this bill.") @map("receipt_footer")
  blockNegativeStock Boolean  @default(false) @map("block_negative_stock")
  roundBillToRupee   Boolean  @default(true) @map("round_bill_to_rupee")
  maxCashierDiscount Decimal  @default(0) @map("max_cashier_discount_pct") @db.Decimal(5, 2)
  // UPI collection: the store's UPI ID and the name shown in the customer's app. A QR with the exact
  // bill amount is generated at the counter from these.
  upiId                String?  @map("upi_id")
  upiPayeeName         String?  @map("upi_payee_name")
  requireUpiReference  Boolean  @default(true) @map("require_upi_reference") // transaction ID must be typed for every UPI payment
  requireCardReference Boolean  @default(false) @map("require_card_reference")
  autoLockMinutes      Int      @default(10) @map("auto_lock_minutes") // 0 = never lock automatically
  returnWindowDays     Int      @default(30) @map("return_window_days") // sales returns accepted up to this many days after the bill
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_setting")
}

model SystemAlert {
  id         Int       @id @default(autoincrement())
  kind       String
  message    String
  details    Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([resolvedAt])
  @@map("system_alert")
}
